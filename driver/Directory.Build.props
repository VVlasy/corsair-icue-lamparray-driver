<!--
  Copyright (c) Corsair Dynamic Lighting Bridge contributors.
  SPDX-License-Identifier: MIT

  Picks up the NuGet WDK and SDK from driver\packages when they have been
  restored (see packages.config).  Each import is conditional, so without a
  restore the installed WDK is used as before.  Lives under driver\ rather
  than the repository root so the CMake-generated user-mode projects never
  see it.
-->
<Project>
  <PropertyGroup>
    <ClaWdkNuGetVersion>10.0.28000.2526</ClaWdkNuGetVersion>
    <ClaPackages>$(MSBuildThisFileDirectory)packages\</ClaPackages>
  </PropertyGroup>
  <Import Project="$(ClaPackages)Microsoft.Windows.WDK.x64.$(ClaWdkNuGetVersion)\build\native\Microsoft.Windows.WDK.x64.props"
          Condition="Exists('$(ClaPackages)Microsoft.Windows.WDK.x64.$(ClaWdkNuGetVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(ClaPackages)Microsoft.Windows.SDK.CPP.x64.$(ClaWdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props"
          Condition="Exists('$(ClaPackages)Microsoft.Windows.SDK.CPP.x64.$(ClaWdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(ClaPackages)Microsoft.Windows.SDK.CPP.$(ClaWdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.props"
          Condition="Exists('$(ClaPackages)Microsoft.Windows.SDK.CPP.$(ClaWdkNuGetVersion)\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
